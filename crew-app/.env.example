# Supabase project URL and server-only secret key (Settings > API Keys).
# Use a secret/service_role key here; publishable/anon keys cannot bypass RLS.
# Never add NEXT_PUBLIC_ to the secret key variable.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SIDE_SECRET_KEY

# Optional: local SQLite fallback location when Supabase is not configured.
# SAGECARE_DB_PATH=./data/sagecare.sqlite
